# JVM options must precede -jar. This example budgets 512 MiB for the Java heap.
# A fixed dump filename preserves the first failure and prevents restart loops
# from filling the disk with multiple dumps. Archive/remove it after diagnosis.
JAVA_OPTS="-Xms128m -Xmx512m -XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError -XX:HeapDumpPath=/var/log/pvz-tv-server/heapdump.hprof -Xlog:gc*,safepoint:file=/var/log/pvz-tv-server/gc.log:time,uptime,level,tags:filecount=5,filesize=10M"
SERVER_OPTS="--base=26667 --shards=4 --dashboard=true"
